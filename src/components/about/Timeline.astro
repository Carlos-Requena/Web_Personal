---
import type { TimelineEntry } from '@constants/about';
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  icon: string;
  entries: TimelineEntry[];
}

const { title, icon, entries } = Astro.props;
---

<div class="flex flex-col gap-5">
  <h3 class="flex items-center gap-2 text-lg font-bold">
    <Icon name={icon} class="text-primary size-5" />
    {title}
  </h3>
  <ol class="border-border relative ml-3 flex flex-col gap-6 border-l pl-6">
    {
      entries.map((entry) => (
        <li class="relative">
          <span class="bg-primary text-primary-foreground absolute -left-[2.15rem] flex size-7 items-center justify-center rounded-full ring-4 ring-[hsl(var(--background))]">
            <Icon name={entry.icon} class="size-4" />
          </span>
          <p class="text-muted-foreground text-sm font-medium">{entry.period}</p>
          <h4 class="font-semibold">{entry.title}</h4>
          <p class="text-primary text-sm">{entry.org}</p>
          <p class="text-muted-foreground mt-1 text-sm">{entry.description}</p>
        </li>
      ))
    }
  </ol>
</div>
