---
import { getAboutContent } from '@constants/about';
import { PAGE_CONTAINER } from '@constants/layout';
import { siteConfig, withBase } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { Icon } from 'astro-icon/components';
import { getLocaleFromUrl, localizedPath } from '@/i18n';
import CareerSection from './CareerSection.astro';
import ContactLinks from './ContactLinks.astro';

const locale = getLocaleFromUrl(Astro.url.pathname);
const data = getAboutContent(locale);
const projectsHref = localizedPath('/projects', locale);
---

<Layout title={`${data.title} | ${siteConfig.title} · ${data.jobTitle}`} description={data.tagline} solidHeader>
  <TwoColumnLayout>
    <div class={`${PAGE_CONTAINER} max-w-4xl`}>
      <!-- ============================ Hero ============================ -->
      <section class="flex items-center gap-8 md:flex-col md:gap-5 md:text-center">
        <img
          src={siteConfig.avatar}
          alt={data.name}
          width="128"
          height="128"
          class="border-border size-32 shrink-0 rounded-full border-4 object-cover shadow-lg md:size-28"
        />
        <div class="flex flex-col gap-2 md:items-center">
          <p class="text-primary text-sm font-semibold tracking-wider uppercase md:text-xs">{data.kicker}</p>
          <h1 class="text-4xl font-bold tracking-tight md:text-3xl">{data.name}</h1>
          <p class="text-lg font-semibold">{data.role}</p>
          <p class="text-muted-foreground max-w-xl text-pretty">{data.tagline}</p>
          <ContactLinks class="mt-2 md:justify-center" />
        </div>
      </section>

      <!-- ========================== Narrative ========================== -->
      <section class="flex flex-col gap-4 leading-relaxed text-pretty">
        {
          data.narrative.map((block) => {
            if (block.type === 'h') {
              return <h2 class="border-primary mt-2 border-l-4 pl-3 text-xl font-bold">{block.text}</h2>;
            }
            if (block.type === 'img') {
              return (
                <figure class="my-2">
                  <img
                    src={withBase(block.src)}
                    alt={block.alt}
                    loading="lazy"
                    class="border-border mx-auto max-h-96 w-full rounded-xl border object-cover shadow-md"
                  />
                  <figcaption class="text-muted-foreground mt-2 text-center text-sm">{block.alt}</figcaption>
                </figure>
              );
            }
            return <p class="text-foreground/90">{block.text}</p>;
          })
        }
      </section>

      <!-- =========================== Skills =========================== -->
      <section class="flex flex-col gap-5">
        <h2 class="flex items-center gap-2 text-2xl font-bold">
          <Icon name="ri:sparkling-2-fill" class="text-primary size-6" />
          {data.labels.skills}
        </h2>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-1">
          {
            data.skills.map((group) => (
              <div class="border-border bg-card flex flex-col gap-3 rounded-xl border p-4 transition-shadow duration-200 hover:shadow-md">
                <h3 class="flex items-center gap-2 font-semibold">
                  <Icon name={group.icon} class="text-primary size-5" />
                  {group.title}
                </h3>
                <ul class="flex flex-wrap gap-2">
                  {group.items.map((item) => (
                    <li class="bg-muted text-muted-foreground rounded-full px-3 py-1 text-sm">{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- ===================== Experience + education ===================== -->
      <CareerSection heading={data.labels.career} />

      <!-- ========================== Projects CTA ========================== -->
      <section class="flex justify-center">
        <a
          href={projectsHref}
          class="border-primary text-primary hover:bg-primary hover:text-primary-foreground inline-flex items-center gap-2 rounded-full border px-6 py-2.5 font-medium transition-colors duration-200"
        >
          <Icon name="ri:function-fill" class="size-5" />
          {data.labels.viewProjects}
        </a>
      </section>
    </div>
  </TwoColumnLayout>
</Layout>
