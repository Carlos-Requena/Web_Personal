---
/**
 * Highlighted card for the featured project (the TFG).
 */
import type { AboutLabels } from '@constants/about';
import { withBase } from '@constants/site-config';
import { getProjectHref } from '@lib/content';
import { Icon } from 'astro-icon/components';
import type { BlogPost } from 'types/blog';
import ProjectLinks from './ProjectLinks.astro';
import StackChips from './StackChips.astro';

interface Props {
  post: BlogPost;
  locale: string;
  labels: AboutLabels;
}

const { post, locale, labels } = Astro.props;
const { title, description, cover, role, stack, links } = post.data;
const href = getProjectHref(post, locale);
---

<article
  class="border-primary/50 bg-card grid grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] overflow-hidden rounded-2xl border-2 shadow-lg tablet:grid-cols-1"
>
  <a href={href} class="flex items-center justify-center bg-white p-10 md:p-6" aria-label={title} tabindex="-1">
    {cover && <img src={withBase(cover)} alt="" loading="lazy" decoding="async" class="max-h-56 w-full object-contain" />}
  </a>
  <div class="flex flex-col gap-3 p-8 md:p-5">
    <span class="bg-primary/15 text-primary inline-flex w-fit items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold">
      <Icon name="ri:award-line" class="size-4" />
      {labels.featured}
    </span>
    <h3 class="text-2xl leading-snug font-bold md:text-xl">
      <a href={href} class="hover:text-primary transition-colors duration-200">{title}</a>
    </h3>
    {description && <p class="text-muted-foreground text-pretty">{description}</p>}
    {
      role && (
        <p class="text-sm">
          <span class="text-muted-foreground">{labels.facts.role}:</span> {role}
        </p>
      )
    }
    <StackChips items={stack} />
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <ProjectLinks links={links} labels={labels} variant="buttons" />
      <a
        href={href}
        class="border-border bg-card hover:border-primary hover:text-primary inline-flex items-center gap-1.5 rounded-full border px-4 py-2 text-sm font-medium transition-colors duration-200"
      >
        {labels.viewProject} →
      </a>
    </div>
  </div>
</article>
