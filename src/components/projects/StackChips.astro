---
import { cn } from '@lib/utils';

interface Props {
  items?: string[];
  class?: string;
}

const { items = [], class: className } = Astro.props;
---

{
  items.length > 0 && (
    <ul class={cn('flex flex-wrap gap-1.5', className)}>
      {items.map((item) => (
        <li class="bg-muted text-muted-foreground rounded-full px-2.5 py-0.5 text-xs">{item}</li>
      ))}
    </ul>
  )
}
