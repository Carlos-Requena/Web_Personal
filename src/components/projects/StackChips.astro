---
import { cn } from '@lib/utils';

interface Props {
  items?: string[];
  /** `onImage`: light chips for dark photo backgrounds */
  tone?: 'default' | 'onImage';
  class?: string;
}

const { items = [], tone = 'default', class: className } = Astro.props;
const chipClass = tone === 'onImage' ? 'bg-white/15 text-white/90' : 'bg-muted text-muted-foreground';
---

{
  items.length > 0 && (
    <ul class={cn('flex flex-wrap gap-1.5', className)}>
      {items.map((item) => (
        <li class={cn('rounded-full px-2.5 py-0.5 text-xs', chipClass)}>{item}</li>
      ))}
    </ul>
  )
}
