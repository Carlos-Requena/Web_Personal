---
import ContactLinks from '@components/about/ContactLinks.astro';
import StackChips from '@components/projects/StackChips.astro';
import { getAboutContent } from '@constants/about';
import { siteConfig } from '@constants/site-config';
import { Icon } from 'astro-icon/components';
import { getLocaleFromUrl } from '@/i18n';

const locale = getLocaleFromUrl(Astro.url.pathname);
const data = getAboutContent(locale);

const badges = [
  { icon: 'ri:checkbox-blank-circle-fill', text: data.badges.availability, accent: true },
  { icon: 'ri:translate-2', text: data.badges.languages, accent: false },
  { icon: 'ri:map-pin-line', text: data.badges.location, accent: false },
];
---

<!-- Rendered on top of the dark PageBanner photo: always light text -->
<section class="flex items-center gap-10 md:flex-col md:gap-5 md:text-center">
  <img
    src={siteConfig.avatar}
    alt={data.name}
    width="176"
    height="176"
    class="size-44 shrink-0 rounded-full border-4 border-white/30 object-cover shadow-lg md:size-28"
  />
  <div class="flex min-w-0 flex-col gap-3 md:items-center">
    <p class="text-sm font-semibold tracking-wider text-primary uppercase md:text-xs">{data.kicker}</p>
    <h1 class="text-5xl font-bold tracking-tight text-white md:text-3xl">{data.name}</h1>
    <p class="text-xl font-semibold text-white md:text-lg">{data.role}</p>
    <p class="max-w-2xl text-pretty text-white/80">{data.tagline}</p>
    <ul class="flex flex-wrap gap-2 md:flex-col md:items-center">
      {
        badges.map((badge) => (
          <li class="inline-flex items-center gap-2 rounded-lg border border-white/25 bg-black/25 px-3 py-1.5 text-sm text-white backdrop-blur-sm">
            <Icon name={badge.icon} class={badge.accent ? 'size-2.5 text-green-400' : 'size-4 text-white/70'} />
            {badge.text}
          </li>
        ))
      }
    </ul>
    <ContactLinks showProjects class="mt-2 md:justify-center" />
    <StackChips items={data.stack} tone="onImage" class="mt-1 md:hidden" />
  </div>
</section>
