---
/**
 * Photo banner with the animated waves for the portfolio pages.
 * With content (home hero) it grows to fit it; without content (`compact`)
 * it is a short decorative strip.
 */
import { withBase } from '@constants/site-config';
import { getLqipStyle } from '@lib/lqip';
import { cn } from '@lib/utils';
import WaveSvg from './wave';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const lqipStyle = getLqipStyle('/img/site_header_1920.webp');
---

<div class={cn('relative z-0 overflow-hidden', compact ? 'h-60 md:h-44' : 'min-h-[36rem]')}>
  <div class="absolute inset-0 -z-10" style={lqipStyle}>
    <img
      src={withBase('/img/site_header_1920.webp')}
      srcset={`${withBase('/img/site_header_800.webp')} 800w,${withBase('/img/site_header_1920.webp')} 1920w`}
      sizes="100vw"
      alt=""
      class="h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <!-- Darken the photo so the hero text stays readable; lighter on the right to keep the skyline visible -->
  <div
    class={cn(
      'absolute inset-0 -z-10',
      compact ? 'bg-black/25' : 'bg-linear-to-r from-black/80 via-black/55 to-black/25 md:bg-black/60',
    )}
  >
  </div>
  {
    !compact && (
      <div class="mx-auto w-full max-w-6xl px-8 pt-28 pb-36 tablet:px-6 md:px-4 md:pt-20 md:pb-24">
        <slot />
      </div>
    )
  }
  <WaveSvg className={compact ? 'wave-compact' : undefined} />
</div>
