---
import CareerSection from '@components/about/CareerSection.astro';
import ContactCta from '@components/home/ContactCta.astro';
import HomeHero from '@components/home/HomeHero.astro';
import ProjectsSection from '@components/projects/ProjectsSection.astro';
import { getAboutContent } from '@constants/about';
import { PAGE_CONTAINER } from '@constants/layout';
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { getProjects } from '@lib/content';
import { getLocaleFromUrl } from '@/i18n';

const locale = getLocaleFromUrl(Astro.url.pathname);
const projects = await getProjects(locale);
const { labels, tagline, jobTitle } = getAboutContent(locale);
---

<Layout title={`${siteConfig.title} · ${jobTitle}`} description={tagline} solidHeader>
  <TwoColumnLayout>
    <div class={PAGE_CONTAINER}>
      <HomeHero />
      <ProjectsSection projects={projects} locale={locale} limit={3} />
      <CareerSection heading={labels.career} />
      <ContactCta />
    </div>
  </TwoColumnLayout>
</Layout>
